<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Re-enable with the first union-based release as the baseline. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>PureQL.CSharp.Model</PackageId>
    <RootNamespace>PureQL.CSharp.Model</RootNamespace>
    <AssemblyName>PureQL.CSharp.Model</AssemblyName>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kudima03/PureQL.CSharp.Model</PackageProjectUrl>
  </PropertyGroup>
</Project>
